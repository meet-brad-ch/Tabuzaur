{
  "name": "tabuzaur",
  "version": "0.8.0",
  "private": true,
  "license": "MIT",
  "description": "Chrome extension that keeps saved pages as links in cards and collections, locally only",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --reporter=default --reporter=json --outputFile=build/tests.json",
    "shots": "node tools/render/shoot.mjs",
    "check:page": "node tools/render/check.mjs",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/chrome": "0.3.5",
    "eslint": "10.12.0",
    "eslint-plugin-jsdoc": "65.4.2",
    "eslint-plugin-sonarjs": "4.2.2",
    "globals": "17.13.0",
    "happy-dom": "21.0.4",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
